# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_GADGET=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM_QFPROM=y
